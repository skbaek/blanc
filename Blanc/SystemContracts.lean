theorem beaconRootsCode_spawnFreeReach : SpawnFreeReach beaconRootsCode :=
  spawnFreeReach_of_check (by decide +kernel)

theorem historyStorageCode_spawnFreeReach : SpawnFreeReach historyStorageCode :=
  spawnFreeReach_of_check (by decide +kernel)

theorem withdrawalRequestCode_spawnFreeReach : SpawnFreeReach withdrawalRequestCode :=
  spawnFreeReach_of_check (by decide +kernel)

theorem consolidationRequestCode_spawnFreeReach : SpawnFreeReach consolidationRequestCode :=
  spawnFreeReach_of_check (by decide +kernel)

/-- Offset-blind spawn-freedom is the special case of `SpawnFreeReach`. -/
theorem SpawnFree.reach {code : ByteArray} (h : SpawnFree code) : SpawnFreeReach code :=
  fun pc x _ => h pc x

/-- **`SpawnFree` is false of the canonical EIP-7002 code**: the `0xF4` at offset `67` decodes as
`DELEGATECALL` when read at that offset, though it is `PUSH` data.  This is why the system
premise of `configuredHistory_*_env` cannot be met on mainnet, and why `SpawnFreeReach` exists. -/
theorem withdrawalRequestCode_not_spawnFree : ¬ SpawnFree withdrawalRequestCode := by
  intro h
  have hd : (match withdrawalRequestCode.getInst 67 with
      | some (.next (.exec .delegatecall)) => true
      | _ => false) = true := by decide +kernel
  refine h 67 .delegatecall ?_
  unfold Xinst.At
  generalize withdrawalRequestCode.getInst 67 = i at hd ⊢
  rcases i with _ | l | n | j
  · cases hd
  · cases hd
  · rcases n with r | x | ⟨xs, hxs⟩ | a | a | a <;> try cases hd
    rcases x <;> first | rfl | cases hd
  · cases hd

/-- The check bites: a `CALL` at an instruction start is refused. -/
theorem spawnFreeCheck_call : spawnFreeCheck ⟨#[0x60, 0x01, 0xf1, 0x00]⟩ = false := by
  decide +kernel

/-- The check skips `PUSH` data: the `CALL` byte here is an immediate. -/
theorem spawnFreeCheck_push_data : spawnFreeCheck ⟨#[0x60, 0xf1, 0x00]⟩ = true := by
  decide +kernel

/-- The four system contracts with their canonical code, in the order `applyBody` calls them. -/
def systemContracts : List (Adr × ByteArray) :=
  [(beaconRootsAddress, beaconRootsCode), (historyStorageAddress, historyStorageCode),
    (withdrawalRequestPredeployAddress, withdrawalRequestCode),
    (consolidationRequestPredeployAddress, consolidationRequestCode)]

/-- The canonical system-contract code is installed in a state. -/
def SystemCodeInstalled (w : State) : Prop :=
  ∀ p ∈ systemContracts, w.getCode p.1 = p.2

/-- The canonical code is nonempty, is not an EIP-7702 delegation designator and spawns nothing at
any reachable position. -/
theorem systemContracts_facts : ∀ p ∈ systemContracts,
    SpawnFreeReach p.2 ∧ ¬ isValidDelegation p.2 ∧ p.2.toList ≠ [] := by
  intro p hp
  simp only [systemContracts, List.mem_cons, List.not_mem_nil, or_false] at hp
  rcases hp with rfl | rfl | rfl | rfl
  · exact ⟨beaconRootsCode_spawnFreeReach, by decide +kernel, by decide +kernel⟩
  · exact ⟨historyStorageCode_spawnFreeReach, by decide +kernel, by decide +kernel⟩
  · exact ⟨withdrawalRequestCode_spawnFreeReach, by decide +kernel, by decide +kernel⟩
  · exact ⟨consolidationRequestCode_spawnFreeReach, by decide +kernel, by decide +kernel⟩

