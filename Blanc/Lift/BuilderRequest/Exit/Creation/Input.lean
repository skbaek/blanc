   0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff,
   0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff,
   0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff,
   0xff, 0x5f, 0x55, 0x61, 0x01, 0xca, 0x80, 0x60,
   0x2d, 0x5f, 0x39, 0x5f, 0xf3]

def creationCode : ByteArray :=
