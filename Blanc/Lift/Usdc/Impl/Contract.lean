import Blanc.Lift.Usdc.CodeImage
import Blanc.Lift.Usdc.Impl.Cert

/-! The certified code semantics of the 23,464-byte `FiatTokenV2_2` implementation runtime at `usdcImpl`.

`Impl.code` is the generated byte literal of the registry row `usdc-impl`
(`scripts/lift/certificates.json`), regenerated byte-identically from the committed runtime by
`scripts/check-lift-certificates.sh`; `Impl.cert_check` (`Impl/Check.lean`) checks the certificate
against it.  The run relation records only that the frame runs these bytes. -/

namespace Blanc.Lift.Usdc

open Jaune

/-- The certified semantics of the 23,464-byte `FiatTokenV2_2` implementation runtime at `usdcImpl`: image `some Impl.code.toList`. -/
def implSem : CodeSem :=
  CodeSem.ofBytes Impl.code (by decide +kernel) (by decide +kernel)

end Blanc.Lift.Usdc
