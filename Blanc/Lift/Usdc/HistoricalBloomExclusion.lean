/-- The first address-digest bit is byte 148, mask 1. -/
theorem address_first_bit :
    LogBloom.byteIndex addressDigest.toBytes 0 = 148 ∧
      LogBloom.bitMask addressDigest.toBytes 0 = 1 := by
  decide +kernel

/-- The first required address bit is absent from the observed C literal. -/
theorem observedC_missing_index :
    ¬ LogBloom.HasIndex observedCBloom addressDigest.toBytes 0 := by
  unfold LogBloom.HasIndex
  decide +kernel

/-- The observed C literal cannot contain a log from the proxy address. -/
theorem observedC_missing :
    ¬ LogBloom.ContainsAddress observedCBloom usdcProxy := by
  intro present
  have first := present.1
  change LogBloom.HasIndex observedCBloom usdcProxy.toBytes.keccak.toBytes 0 at first
  rw [address_digest] at first
  exact observedC_missing_index first

/-- Conditional application to the same original configured block execution.
The observed-to-original header identity is an explicit consumer obligation. -/
theorem address_ne_of_observedCBloom
    {F : Fork → Prop} {cfg : ChainConfig} {pre post : BlockChain}
    (trace : ConfiguredBlockTraceIn F cfg pre post)
    (header : trace.block.header.bloom = observedCBloom)
    {log : Log} (member : log ∈ trace.blockOutput.blockLogs) :
    log.address ≠ usdcProxy := by
  apply trace.address_ne_of_bloom_missing (address := usdcProxy) _ member
  rw [header]
  exact observedC_missing

/-- The first required address bit is absent from the observed D literal. -/
theorem observedD_missing_index :
    ¬ LogBloom.HasIndex observedDBloom addressDigest.toBytes 0 := by
  unfold LogBloom.HasIndex
  decide +kernel

/-- The observed D literal cannot contain a log from the proxy address. -/
theorem observedD_missing :
    ¬ LogBloom.ContainsAddress observedDBloom usdcProxy := by
  intro present
  have first := present.1
  change LogBloom.HasIndex observedDBloom usdcProxy.toBytes.keccak.toBytes 0 at first
  rw [address_digest] at first
  exact observedD_missing_index first

/-- Conditional application to the same original configured block execution.
The observed-to-original header identity is an explicit consumer obligation. -/
theorem address_ne_of_observedDBloom
    {F : Fork → Prop} {cfg : ChainConfig} {pre post : BlockChain}
    (trace : ConfiguredBlockTraceIn F cfg pre post)
    (header : trace.block.header.bloom = observedDBloom)
    {log : Log} (member : log ∈ trace.blockOutput.blockLogs) :
    log.address ≠ usdcProxy := by
  apply trace.address_ne_of_bloom_missing (address := usdcProxy) _ member
  rw [header]
  exact observedD_missing

