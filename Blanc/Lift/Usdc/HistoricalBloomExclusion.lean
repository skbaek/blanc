def addressDigest : B256 :=
  0x7b5855bb92cd7f3f78137497df02f6ccb9badda93d9782e0f230c807ba728be0

/-- The actual Keccak primitive produces the displayed finite digest. -/
theorem address_digest : usdcProxy.toBytes.keccak = addressDigest := by
  apply eq_of_beq
  decide +kernel

