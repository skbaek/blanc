import Blanc.Lift.Usdc.CodeImage
import Blanc.Lift.Usdc.Lib.Cert

/-! The certified code semantics of the 1,741-byte `SignatureChecker` library runtime at `usdcLib`.

`Lib.code` is the generated byte literal of the registry row `usdc-lib`
(`scripts/lift/certificates.json`), regenerated byte-identically from the committed runtime by
`scripts/check-lift-certificates.sh`; `Lib.cert_check` (`Lib/Check.lean`) checks the certificate
against it.  The run relation records only that the frame runs these bytes. -/

namespace Blanc.Lift.Usdc

open Jaune

/-- The certified semantics of the 1,741-byte `SignatureChecker` library runtime at `usdcLib`: image `some Lib.code.toList`. -/
def libSem : CodeSem :=
  CodeSem.ofBytes Lib.code (by decide +kernel) (by decide +kernel)

end Blanc.Lift.Usdc
