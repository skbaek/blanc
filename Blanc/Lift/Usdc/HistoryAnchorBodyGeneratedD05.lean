/-- Nine actual Jaune field-parser steps, with full ordered consumption. -/
theorem d41_payload_parse (k : Nat) :
    Bytes.toBLTs? (k + 9) d41Payload = some d41Fields := by
  unfold d41Payload d41Fields
  simp only [List.append_assoc, List.cons_append, List.nil_append]
  apply RlpConcrete.parse_cons
  · exact RlpConcrete.decode_bytes_short _ 2 d41F0 _ (by decide +kernel) rfl
  apply RlpConcrete.parse_cons
  · exact RlpConcrete.decode_bytes_short _ 4 d41F1 _ (by decide +kernel) rfl
  apply RlpConcrete.parse_cons
  · exact RlpConcrete.decode_bytes_short _ 3 d41F2 _ (by decide +kernel) rfl
  apply RlpConcrete.parse_cons
  · exact RlpConcrete.decode_bytes_short _ 20 d41F3 _ (by decide +kernel) rfl
  apply RlpConcrete.parse_cons
  · exact RlpConcrete.decode_empty_bytes _ _
  apply RlpConcrete.parse_cons
  · exact RlpConcrete.decode_bytes_long_two _ 1 132 d41F5 _ (by decide +kernel)
  apply RlpConcrete.parse_cons
  · exact RlpConcrete.decode_byte _ _ _ (by decide +kernel)
  apply RlpConcrete.parse_cons
  · exact RlpConcrete.decode_bytes_short _ 32 d41F7 _ (by decide +kernel) rfl
  apply RlpConcrete.parse_cons
  · simpa only [List.append_nil, Nat.toUInt8_eq, UInt8.reduceOfNat, UInt8.reduceAdd] using RlpConcrete.decode_bytes_short _ 32 d41F8 [] (by decide +kernel) rfl
  rw [Bytes.toBLTs?]

theorem d41_parse : d41Signed.toBLT? = some (.list d41Fields) := by
  have outer : Bytes.toBLTDiff? 495 d41Signed = some (.list d41Fields, []) := by
    simpa only [d41Signed, List.cons_append, List.nil_append, List.append_nil] using
      RlpConcrete.decode_list_long_two 494 1 236 d41Payload [] d41Fields
        (by rw [d41_payload_length]; decide +kernel) (d41_payload_parse 485)
  unfold Bytes.toBLT?
  rw [d41_signed_length, outer]

