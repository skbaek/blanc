import Blanc.Lift.Usdc.CodeImage
import Blanc.Lift.Usdc.Proxy.Cert

/-! The certified code semantics of the 2,186-byte `FiatTokenProxy` runtime at `usdcProxy`.

`Proxy.code` is the generated byte literal of the registry row `usdc-proxy`
(`scripts/lift/certificates.json`), regenerated byte-identically from the committed runtime by
`scripts/check-lift-certificates.sh`; `Proxy.cert_check` (`Proxy/Check.lean`) checks the certificate
against it.  The run relation records only that the frame runs these bytes. -/

namespace Blanc.Lift.Usdc

open Jaune

/-- The certified semantics of the 2,186-byte `FiatTokenProxy` runtime at `usdcProxy`: image `some Proxy.code.toList`. -/
def proxySem : CodeSem :=
  CodeSem.ofBytes Proxy.code (by decide +kernel) (by decide +kernel)

end Blanc.Lift.Usdc
