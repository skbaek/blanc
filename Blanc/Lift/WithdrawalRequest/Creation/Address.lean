import Jaune.Execution

/-! The modeled CREATE address of the recorded keyless deployer at nonce zero. -/

namespace Blanc.Lift.WithdrawalRequest.Creation

open Jaune

def deployer : Adr := 0x8646861a7cf453ddd086874d622b0696de5b9674

/-- The recorded sender and nonce compute the actual withdrawal predeploy target. -/
theorem deployer_address : computeContractAddress deployer 0 = withdrawalRequestPredeployAddress := by
  have hs : deployer.toBytes = [0x86, 0x46, 0x86, 0x1a, 0x7c, 0xf4, 0x53, 0xdd, 0xd0, 0x86, 0x87, 0x4d, 0x62, 0x2b, 0x06, 0x96, 0xde, 0x5b, 0x96, 0x74] := by rfl
  have hz : (UInt64.toBytes 0).sig = [] := by rfl
  have hr : BLT.toBytes (.list [.bytes [0x86, 0x46, 0x86, 0x1a, 0x7c, 0xf4, 0x53, 0xdd, 0xd0, 0x86, 0x87, 0x4d, 0x62, 0x2b, 0x06, 0x96, 0xde, 0x5b, 0x96, 0x74], .bytes []]) = [0xd6, 0x94, 0x86, 0x46, 0x86, 0x1a, 0x7c, 0xf4, 0x53, 0xdd, 0xd0, 0x86, 0x87, 0x4d, 0x62, 0x2b, 0x06, 0x96, 0xde, 0x5b, 0x96, 0x74, 0x80] := by
    simp only [BLT.toBytes, BLTs.toBytes, BLTs.toBytesJoin, List.length_cons, List.length_nil]
    decide +kernel
  simp only [computeContractAddress, hs, hz, hr]
  decide +kernel

end Blanc.Lift.WithdrawalRequest.Creation
