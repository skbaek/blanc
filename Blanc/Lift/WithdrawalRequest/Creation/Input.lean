import Blanc.SystemContracts

/-! Recorded keyless creation input, with one reference to the canonical runtime. -/

namespace Blanc.Lift.WithdrawalRequest.Creation

open Jaune

/-- PUSH32 inhibitor; PUSH0/SSTORE; copy the 504-byte runtime from offset 45; RETURN. -/
def constructorPrefix : Bytes :=
  [0x7f, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff,
   0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff,
   0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff,
   0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff,
   0xff, 0x5f, 0x55, 0x61, 0x01, 0xf8, 0x80, 0x60,
   0x2d, 0x5f, 0x39, 0x5f, 0xf3]

def creationCode : ByteArray :=
  ⟨(constructorPrefix ++ Blanc.withdrawalRequestCode.toList).toArray⟩

end Blanc.Lift.WithdrawalRequest.Creation
