theorem txB_signingHash :
    txB.signingHash =
      some (0x96965e9b6fd81da4224f3d8156ec6d76ecf1864ea27a6d25f2e201fabd1e0c08 : B256) := by
  rw [txB_signingEncoded]
  decide +kernel

theorem txC_signingHash :
    txC.signingHash =
      some (0x5c61284d58fe1a9bee9d1b4e43390b20f1741093e623621bd32d77bf7a900d66 : B256) := by
  rw [txC_signingEncoded]
  decide +kernel

theorem txB_recoveredSender : recoverSender 1 txB = .ok senderE := by
  rw [recoverSender, txB_signingHash]
  decide +kernel

theorem txC_recoveredSender : recoverSender 1 txC = .ok senderE := by
  rw [recoverSender, txC_signingHash]
  decide +kernel

end Blanc.Lift.WithdrawalRequest.FloodTx
