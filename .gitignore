/.lake
/scripts/report-*.txt
# Host-local elaboration performance reference, initialized by check-elab.sh.
/scripts/baseline-elab.txt
# Gate locks (scripts/gate-lock.sh): live only for a run's duration, and a
# stale one is reclaimed by the next run rather than committed.
*.lock/
*.code-workspace
__pycache__/

# Per-goal Git worktrees. Creme's execution guide requires a dedicated
# worktree per goal; the convention is that a worktree for the repository at
# PATH lives in PATH/.worktrees/<goal>, so it needs no assumption about the
# layout above the repository and no write access outside it.
/.worktrees/
