+++ b/packages/testing/src/execution_testing/client_clis/tests/test_jaune.py
@@ -0,0 +1,122 @@
+"""Tests for the Jaune transition-tool wrapper and its exception mapper."""
+
+from pathlib import Path
+
+import pytest
+
+from execution_testing.client_clis import (
+    JauneExceptionMapper,
+    JauneTransitionTool,
+)
+from execution_testing.client_clis.clis.jaune import JAUNE_IDENTITIES
+from execution_testing.client_clis.transition_tool import TransitionTool
+from execution_testing.exceptions import (
+    BlockException,
+    TransactionException,
+    UndefinedException,
+)
+
+
+def test_registered_as_a_transition_tool() -> None:
+    """The wrapper must be registered, or `--evm-bin` never reaches it."""
+    assert JauneTransitionTool in TransitionTool.registered_tools
+
+
+@pytest.mark.parametrize(
+    "banner,expected",
+    [
+        ("jaune version 0.1.0", True),
+        ("jaune version 1.2.3-rc1", True),
+        ("jaune", False),
+        ("jaunet version 0.1.0", False),
+        ("evm version 1.16.0-stable", False),
+        ("ethereum-spec-evm 0.1.0", False),
+        ("", False),
+    ],
+)
+def test_detect_binary(banner: str, expected: bool) -> None:
+    """Detection keys on the banner `jaune -v` prints and nothing else."""
+    assert (
+        JauneTransitionTool.detect_binary(banner, Path("jaune")) is expected
+    )
+
+
+def test_every_declared_identity_maps_to_itself() -> None:
+    """
+    Jaune writes the official identity verbatim, so every declared identity
+    must map to exactly itself -- not to a neighbour, and not to two.
+    """
+    mapper = JauneExceptionMapper()
+    for identity in JAUNE_IDENTITIES:
+        matched = mapper.message_to_exception(str(identity))
+        assert not isinstance(matched, UndefinedException), (
+            f"{identity} is declared but does not map"
+        )
+        assert matched == [identity], f"{identity} mapped to {matched}"
+
+
+def test_nested_identities_do_not_both_match() -> None:
+    """
+    Two declared identities nest: `BlockException.UNKNOWN_PARENT` inside
+    `BlockException.UNKNOWN_PARENT_ZERO`. Substring matching would return both
+    for the longer message, so the mapper anchors and this pins that.
+    """
+    mapper = JauneExceptionMapper()
+    assert mapper.message_to_exception(
+        "BlockException.UNKNOWN_PARENT_ZERO"
+    ) == [BlockException.UNKNOWN_PARENT_ZERO]
+    assert mapper.message_to_exception("BlockException.UNKNOWN_PARENT") == [
+        BlockException.UNKNOWN_PARENT
+    ]
+
+
+def test_a_message_merely_containing_an_identity_does_not_match() -> None:
+    """
+    The whole message is the identity. A message that only quotes one is not
+    a classification and must stay undefined.
+    """
+    matched = JauneExceptionMapper().message_to_exception(
+        "Failed transaction: TransactionException.NONCE_MISMATCH_TOO_HIGH "
+        "(and something else)"
+    )
+    assert isinstance(matched, UndefinedException)
+
+
+def test_a_representative_rejection_maps() -> None:
+    """The rejection the acceptance corpus produces, end to end."""
+    mapper = JauneExceptionMapper()
+    assert mapper.message_to_exception(
+        "TransactionException.NONCE_MISMATCH_TOO_HIGH"
+    ) == [TransactionException.NONCE_MISMATCH_TOO_HIGH]
+    assert mapper.message_to_exception(
+        "BlockException.SYSTEM_CONTRACT_CALL_FAILED"
+    ) == [BlockException.SYSTEM_CONTRACT_CALL_FAILED]
+
+
+@pytest.mark.parametrize(
+    "message",
+    [
+        # What Jaune writes when it cannot classify a typed reason: the
+        # `headerNonce` block rule, which the fixture vocabulary has no
+        # identity for, and every VM or internal failure.
+        "JauneT8n.UNMAPPED_BLOCK: HeaderNonceError : nonce is not zero",
+        "JauneT8n.UNMAPPED_VM: some vm failure",
+        # What it writes when a `txs` entry never becomes a transaction.
+        "JauneT8n.TX_PARSE_UNKNOWN_FIELD: nonsense",
+        "JauneT8n.TX_PARSE_UNSUPPORTED_TYPE: 9",
+        # And a plausible near-miss, to show the mapper is not fuzzy.
+        "TransactionException.NOT_A_REAL_IDENTITY",
+        "nonce too high",
+    ],
+)
+def test_an_unmapped_reason_fails_loudly(message: str) -> None:
+    """
+    An unmapped reason must surface as `UndefinedException`, never as a
+    silently accepted match. This is the property that stops a rejection Jaune
+    could not classify from validating a test that expected a specific one.
+    """
+    matched = JauneExceptionMapper().message_to_exception(message)
+    assert isinstance(matched, UndefinedException), (
+        f"{message!r} was mapped to {matched} instead of being undefined"
+    )
+    assert matched.mapper_name == "JauneExceptionMapper"
